He does: i.e., bestowing and implementing mercy."}]},{"a":2,"w":[{"p":1,"ar":[{"t":"ٱلۡحَمۡدُ"}],"en":[{"t":"All ","c":"n"},{"t":"praises ","c":"n"},{"t":"and ","c":"n"},{"t":"thanks","c":"n"}],"v":"21-006"},{"p":2,"ar":[{"t":"لِلَّهِ"}],"en":[{"t":"(be) ","c":"paren"},{"t":"to ","c":"p"},{"t":"Allah","c":"pn"}],"v":"02-002"},{"p":3,"ar":[{"t":"رَبِّ"}],"en":[{"t":"the ","c":"pn"},{"t":"Lord","c":"pn"}],"v":"13-002"},{"p":4,"ar":[{"t":"ٱ","c":"ham_wasl"},{"t":"لۡعَ"},{"t":"ـٰ","c":"madda_normal"},{"t":"لَمِ"},{"t":"ي","c":"madda_permissible"},{"t":"نَ"}],"en":[{"t":"of ","c":"n"},{"t":"the ","c":"n"},{"t":"universe","c":"n"}],"v":"27-006"}],"tr":[{"t":"[All] praise is [due] to Allāh, Lord"},{"n":"1","fn":"- When referring to Allāh (subḥānahu wa taʿālā) , the Arabic term \"rabb\" (translated as \"Lord\") includes all of the following meanings: \"owner, master, ruler, controller, sustainer, provider, guardian and caretaker.\""},{"t":" of the worlds -"}]},{"a":3,"w":[{"p":1,"ar":[{"t":"ٱ"},{"t":"ل","c":"laam_shamsiyah"},{"t":"رَّحۡمَ"},{"t":"ـٰ","c":"madda_normal"},{"t":"نِ"}],"en":[{"t":"The ","c":"p"},{"t":"Most ","c":"pn"},{"t":"Gracious","c":"pn"}],"v":"13-003"},{"p":2,"ar":[{"t":"ٱ","c":"ham_wasl"},{"t":"ل","c":"laam_shamsiyah"},{"t":"رَّحِ"},{"t":"ي","c":"madda_permissible"},{"t":"مِ"}],"en":[{"t":"the ","c":"p"},{"t":"Most ","c":"pn"},{"t":"Merciful","c":"pn"}],"v":"16-008"}],"tr":[{"t":"The Entirely Merciful, the Especially Merciful,"}]},{"a":4,"w":[{"p":1,"ar":[{"t":"مَ"},{"t":"ـٰ","c":"madda_normal"},{"t":"لِكِ"}],"en":[{"t":"(The) ","c":"paren"},{"t":"Master","c":"pn"}],"v":"lem:مالِك"},{"p":2,"ar":[{"t":"يَوۡمِ"}],"en":[{"t":"(of the) ","c":"paren"},{"t":"Day","c":"n"}],"v":"19-011"},{"p":3,"ar":[{"t":"ٱ","c":"ham_wasl"},{"t":"ل","c":"laam_shamsiyah"},{"t":"دِّ"},{"t":"ي","c":"madda_permissible"},{"t":"نِ"}],"en":[{"t":"(of the) ","c":"paren"},{"t":"Judgment","c":"n"}],"v":"21-007"}],"tr":[{"t":"Sovereign of the Day of Recompense."},{"n":"1","fn":"- i.e., r