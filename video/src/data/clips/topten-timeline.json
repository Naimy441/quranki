   "sayStart": 0.25,
   "sayEnd": 4.49,
   "say": "A quarter of the entire Quran is made of just ten words."
  },
  "hook2": {
   "start": 4.69,
   "end": 7.73,
   "sayStart": 4.69,
   "sayEnd": 7.73,
   "say": "And number one isn't the word you'd guess."
  },
  "w10": {
   "start": 8.030000000000001,
   "end": 11.3778068,
   "sayStart": 8.8978068,
   "sayEnd": 11.3778068,
   "say": "Ten. He was."
  },
  "w9": {
   "start": 11.5778068,
   "end": 13.931379799999998,
   "sayStart": 12.8113798,
   "sayEnd": 13.931379799999998,
   "say": "On."
  },
  "w8": {
   "start": 14.131379799999998,
   "end": 17.880485799999995,
   "sayStart": 15.480485799999997,
   "sayEnd": 17.880485799999995,
   "say": "Who, or which."
  },
  "w7": {
   "start": 18.080485799999995,
   "end": 20.175406799999994,
   "sayStart": 19.055406799999993,
   "sayEnd": 20.175406799999994,
   "say": "He said."
  },
  "w6": {
   "start": 20.375406799999993,
   "end": 22.908163799999993,
   "sayStart": 21.788163799999992,
   "sayEnd": 22.908163799999993,
   "say": "Indeed."
  },
  "w5": {
   "start": 23.108163799999993,
   "end": 25.129331799999992,
   "sayStart": 24.16933179999999,
   "sayEnd": 25.129331799999992,
   "say": "In."
  },
  "w4": {
   "start": 25.32933179999999,
   "end": 28.54902479999999,
   "sayStart": 26.30902479999999,
   "sayEnd": 28.54902479999999,
   "say": "No, or not."
  },
  "w3": {
   "start": 28.74902479999999,
   "end": 30.96488679999999,
   "sayStart": 29.84488679999999,
   "sayEnd": 30.96488679999999,
   "say": "What."
  },
  "w2": {
   "start": 31.16488679999999,
   "end": 36.851385799999996,
   "sayStart": 32.611385799999994,
   "sayEnd": 36.851385799999996,
   "say": "Allah. Almost twenty-seven hundred times."
  },
  "w1": {
   "start": 37.3013858,
   "end": 43.3635948,
   "sayStart": 38.1635948,
   "sayEnd": 43.3635948,
   "say": "And number one: from. Over thirty-two hundred times."
  },
  "sum": {
   "start": 43.813594800000004,
   "end": 49.173594800000004,
   "sayStart": 43.813594800000004,
   "sayEnd": 49.173594800000004,
   "say": "Learn these ten, and you already know one in every four words of the Quran."
  },
  "cta": {
   "start": 49.523594800000005,
   "end": 53.843594800000005,
   "sayStart": 49.523594800000005,
   "sayEnd": 53.843594800000005,
   "say": "Quranki teaches the Quran’s words in exactly this order."
