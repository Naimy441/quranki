rules_version = '2';

// Quranki's Storage bucket hosts large, optional datasets (e.g. per-reciter recitation
// data) that the app downloads on demand instead of bundling into the binary. Everything
// under `recitation-data/` is public-read, immutable-by-clients content: no user auth
// exists in this app, so reads are open, but all writes are blocked - files are only
// ever published by `scripts/upload-recitation-data.js` using the Admin SDK, which
// bypasses these rules entirely.
service firebase.storage {
  match /b/{bucket}/o {
    match /recitation-data/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Per-translation ayah text (see `scripts/upload-translation-data.js` and
    // `lib/translation-dataset.ts`) - same public-read, admin-only-write shape as
    // `recitation-data/` above.
    match /translation-data/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
