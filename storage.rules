rules_version = '2';

// Quranki's Storage bucket hosts large, optional datasets (e.g. per-reciter recitation
// data) that the app downloads on demand instead of bundling into the binary. Everything
// under `recitation-data/` is public-read, immutable-by-clients content. Optional accounts
// persist learned-word ids in Firestore, not Storage, so reads stay open and writes stay
// blocked. Files are only ever published by `scripts/upload-recitation-data.js` using the
// Admin SDK, which bypasses these rules entirely.
service firebase.storage {
  match /b/{bucket}/o {
    match /recitation-data/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Per-translation ayah text (see `scripts/upload-translation-data.js` and
    // `lib/translation-dataset.ts`) - same public-read, admin-only-write shape as
    // `recitation-data/` above.
    match /translation-data/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Qaida letter-name / syllable MP3s, stored gzipped (see `scripts/upload-qaida-audio.js`
    // and `lib/qaida-audio.ts`). Same public-read, admin-only-write shape.
    match /qaida-audio/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
